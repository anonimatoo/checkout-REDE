{
  "name": "cs-rede-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "migrate": "node --env-file-if-exists=.env backend/src/cli.js migrate",
    "admin:create": "node --env-file-if-exists=.env backend/src/cli.js create-admin",
    "admin:recover": "node --env-file-if-exists=.env backend/src/cli.js recover-admin",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.12.8",
    "lucide-react": "^1.79.0",
    "pg": "^8.23.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  },
  "devDependencies": {
    "vite": "^7.3.8"
  }
}
